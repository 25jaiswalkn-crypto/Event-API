# Copy the Supabase PostgreSQL Session pooler connection string from Dashboard > Connect.
# Keep this value server-side only; never add DATABASE_URL to Vercel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_character_hex_string
PORT=3000

# Set both values before the first Render deployment to create one initial admin.
# Remove ADMIN_PASSWORD from Render after the first successful seed; the hashed account remains.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters
ADMIN_NAME=Event Administrator

# Optional, defaults to 5 server-side connections.
PG_POOL_MAX=5
